{
  "name": "notify-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Notification gateway for renewal and backup jobs — email + Telegram via Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 43147 --ip 0.0.0.0",
    "start": "wrangler dev --port 43147 --ip 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute notify-tasks --local --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.37.0"
  }
}
